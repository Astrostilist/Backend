# ======================================================================
# .env.template — для prod/серверного запуска через docker-compose.yaml
# Скопируйте: cp .env.template .env  и заполните секреты
# ======================================================================

# ---- Webserver / runtime --------------------------------------------
APP_IMAGE=ghcr.io/astrostilist/backend:main
BOT_API_KEY=__CHANGEME_BOT_API_KEY__
ADMIN_TOKEN=__CHANGEME_ADMIN_TOKEN__
CADDY_LETSENCRYPT_EMAIL=email@for.letsencrypt
CADDY_DOMAIN_NAME=domain.for.letsencrypt

# Logger
LOG_SERVICE_NAME=go-api-backend
LOG_LEVEL=info # debug | info | error | warn | warning

# Logger
LOG_SERVICE_NAME=go-api-backend
LOG_LEVEL=info # debug | info | error | warn | warning
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 32 байта, base64-encoded. Сгенерить: make generate-key
ENCRYPTION_KEY=__CHANGEME_GENERATE_VIA_make_generate-key__

# ---- Cache -----------------------------------------------------------
MEMCACHED_HOST=memcached:11211

# ---- Logger ----------------------------------------------------------
LOG_SERVICE_NAME=astro-backend
LOG_LEVEL=info  # debug | info | warn | error

# ---- Tracing ---------------------------------------------------------
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_SERVICE_NAME=astro-backend

# ---- PostgreSQL ------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGEME__
POSTGRES_DB=astrobackend

# Переменные, которые читает приложение
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=__CHANGEME__
DB_NAME=astrobackend
DB_SSL_MODE=disable

DB_MAX_CONNS=50
DB_MIN_CONNS=20
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m

# ---- NATS ------------------------------------------------------------
NATS_HOST=nats
NATS_PORT=4222
NATS_CLUSTER_ID=test-cluster
NATS_CLIENT_ID=astro-backend

# ---- AlisaAI / Yandex Cloud ----------------------------------------
AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
AI_API_KEY=__CHANGEME__
AI_MODEL_URL=gpt://__FOLDER_ID__/yandexgpt-lite/latest

# ---- AUTH-02 SuperAdmin bootstrap ------------------------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=__CHANGEME_MIN_8_CHARS__
