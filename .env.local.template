# ======================================================================
# .env.local.template — для локальной разработки
# Схема: docker-compose.local.yaml поднимает только инфру с проброшенными
# портами на localhost. Приложение запускается на хосте: make run
# Скопируйте: cp .env.local.template .env
# ======================================================================

# ---- Application -----------------------------------------------------
BOT_API_KEY=local-bot-api-key
ADMIN_TOKEN=local-admin-token
ENCRYPTION_KEY=__CHANGEME_GENERATE_VIA_make_generate-key__

LOG_SERVICE_NAME=astro-backend
LOG_LEVEL=debug

# ---- Tracing ---------------------------------------------------------
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_SERVICE_NAME=astro-backend

# ---- Cache -----------------------------------------------------------
MEMCACHED_HOST=localhost:11211

# ---- PostgreSQL (local container, port 5432 exposed) ---------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=astrobackend

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=astrobackend
DB_SSL_MODE=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=30s

# ---- NATS (local container, port 4222 exposed) ---------------------
NATS_HOST=localhost
NATS_PORT=4222
NATS_CLUSTER_ID=test-cluster
NATS_CLIENT_ID=astro-backend-local

# ---- AlisaAI ---------------------------------------------------------
AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
AI_API_KEY=__CHANGEME__
AI_MODEL_URL=gpt://__FOLDER_ID__/yandexgpt-lite/latest

# ---- AUTH-02 SuperAdmin bootstrap ------------------------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=__CHANGEME_MIN_8_CHARS__
